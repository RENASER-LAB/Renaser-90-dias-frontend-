# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.local
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

### Grafo de conocimiento de graphify (graphify-out/) ###
# Artefactos derivados: se reconstruyen solos via el hook post-commit
# (`graphify update .`, solo AST, sin coste de API). No se versionan.
graphify-out/
.claude/settings.json.graphify-bak

# Configuracion local del IDE (JetBrains): es de cada maquina, no del proyecto.
.idea/

# Worktrees que crea Claude Code dentro del proyecto: son checkouts completos
# del repo. Estaba solo en .git/info/exclude, que no se comparte con el equipo.
.claude/worktrees/

# Resultados de E2E: artefactos derivados, nunca versionados (pueden llevar capturas con datos).
artifacts/
test-results/
playwright-report/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
