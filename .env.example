# Renaser Mobile App Environment Variables Example
# Duplicate this file as .env and fill in your private API keys

# Google Places API Key (from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# URL base del backend Java (Spring Boot). Sin barra final.
# Emulador Android: http://10.0.2.2:8080 — en el emulador, localhost es el emulador mismo.
# Dispositivo fisico con Expo Go: la IP LAN de tu maquina, ej. http://192.168.1.50:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# ID de cliente OAuth de Google (Google Cloud Console > Credenciales > ID de cliente).
# ATENCION: aca va el ID, nunca el SECRETO. Todo lo que empieza con EXPO_PUBLIC_ queda
# incrustado en el bundle de la app y cualquiera puede leerlo. El client_secret se canjea
# en el backend (GOOGLE_OAUTH_CLIENT_SECRET), que es el unico lugar donde esta a salvo.
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
