{
  "expo": {
    "name": "renaser",
    "slug": "renaser",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.renaser.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "package": "com.renaser.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Renaser necesita acceder a tus fotos y videos para que puedas adjuntar una imagen a tus publicaciones del Muro y subir la evidencia de tus hábitos.",
          "cameraPermission": "Renaser necesita la cámara para que puedas tomar la foto o grabar el video con el que registras la evidencia de tus hábitos.",
          "microphonePermission": "Renaser necesita el micrófono para grabar el audio de los videos con los que registras la evidencia de tus hábitos."
        }
      ],
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Renaser necesita el micrófono para que puedas grabar en audio la evidencia de tus hábitos."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Renaser usa el micrófono para que puedas dictarle tus mensajes al acompañante.",
          "speechRecognitionPermission": "Renaser convierte tu voz en texto para que puedas hablarle al acompañante en vez de escribir."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sonidos/campana_renaser.wav",
            "./assets/sonidos/voz_habito.mp3",
            "./assets/sonidos/voz_evento.mp3",
            "./assets/sonidos/voz_objetivos.mp3",
            "./assets/sonidos/voz_habito_despertar.mp3",
            "./assets/sonidos/voz_habito_agua_tibia.mp3",
            "./assets/sonidos/voz_habito_ritual_manana.mp3",
            "./assets/sonidos/voz_habito_dia_sin_celular.mp3",
            "./assets/sonidos/voz_habito_clase_diaria.mp3",
            "./assets/sonidos/voz_habito_jugo_verde.mp3",
            "./assets/sonidos/voz_habito_primera_comida.mp3",
            "./assets/sonidos/voz_habito_ritual_mediodia.mp3",
            "./assets/sonidos/voz_habito_ultima_comida.mp3",
            "./assets/sonidos/voz_habito_ritual_noche.mp3",
            "./assets/sonidos/voz_habito_escritura_libre.mp3",
            "./assets/sonidos/voz_habito_post_comunidad.mp3",
            "./assets/sonidos/voz_habito_pastilla_renacer.mp3",
            "./assets/sonidos/voz_habito_dormir.mp3",
            "./assets/sonidos/voz_habito_audioterapia.mp3",
            "./assets/sonidos/voz_habito_descanso_profundo.mp3",
            "./assets/sonidos/voz_habito_agua_hidratacion.mp3",
            "./assets/sonidos/alertar_amanecer.mp3",
            "./assets/sonidos/alertar_marimba.mp3",
            "./assets/sonidos/alertar_campana.mp3",
            "./assets/sonidos/alertar_kalimba.mp3",
            "./assets/sonidos/relajar_cuenco.mp3",
            "./assets/sonidos/relajar_campanitas.mp3",
            "./assets/sonidos/relajar_lluvia.mp3",
            "./assets/sonidos/relajar_ruido_marron.mp3"
          ]
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "390944e9-a787-4479-90c8-cae078bc9d59"
      }
    }
  }
}
