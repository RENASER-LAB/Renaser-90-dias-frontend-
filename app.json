{
  "expo": {
    "name": "renaser",
    "slug": "renaser",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.renaser.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "package": "com.renaser.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Renaser necesita acceder a tus fotos y videos para que puedas adjuntar una imagen a tus publicaciones del Muro y subir la evidencia de tus hábitos.",
          "cameraPermission": "Renaser necesita la cámara para que puedas tomar la foto o grabar el video con el que registras la evidencia de tus hábitos.",
          "microphonePermission": "Renaser necesita el micrófono para grabar el audio de los videos con los que registras la evidencia de tus hábitos."
        }
      ],
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Renaser necesita el micrófono para que puedas grabar en audio la evidencia de tus hábitos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "390944e9-a787-4479-90c8-cae078bc9d59"
      }
    }
  }
}
