{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "renaser-web-adjunto",
      "url": "http://localhost:8081",
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "renaser-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "grafo",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8899",
        "--directory",
        "graphify-out"
      ],
      "port": 8899,
      "autoPort": false
    }
  ]
}
